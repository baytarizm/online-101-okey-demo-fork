PORT=3000
YAZBOZ_ORIGIN=https://yazbozhaysag.vercel.app
# Optional: mount a persistent volume here and run exactly one process.
# STATE_FILE=/app/data/rooms.json

# Defaults for new tables; hosts can choose easy / medium / hard.
BOT_DIFFICULTY=medium
# Server-only hard-search tuning (samples 0..256, budget 0..100 ms).
BOT_MC_SAMPLES=24
BOT_MC_BUDGET_MS=35
